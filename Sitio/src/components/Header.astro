---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="header-container">
		<div class="logo">
			<a href="/">
				<span class="text-gradient-blue">{SITE_TITLE}</span>
			</a>
		</div>
		<nav>
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Noticias y Guías</HeaderLink>
			<HeaderLink href="/quests">Misiones</HeaderLink>
			<HeaderLink href="/about">Nosotros</HeaderLink>
		</nav>
		<div class="header-actions">
			<a href="#" class="button button-primary">Discord</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		background: rgba(11, 12, 16, 0.85);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--color-border);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	
	.header-container {
		width: 1200px;
		max-width: calc(100% - 2rem);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4.5rem;
	}

	.logo {
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 900;
		letter-spacing: -0.02em;
	}

	.logo a {
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 2rem;
		align-items: center;
	}

	nav a {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--color-text-main);
		text-decoration: none;
		padding: 0.5rem 0;
		position: relative;
		transition: color 0.2s ease;
	}

	nav a:hover, nav a.active {
		color: var(--color-gold);
	}

	nav a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--color-gold);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s ease;
		box-shadow: 0 0 10px var(--color-gold-glow);
	}

	nav a:hover::after, nav a.active::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.header-actions {
		display: flex;
		align-items: center;
	}
	
	@media (max-width: 768px) {
		nav {
			display: none;
		}
		.header-actions {
			display: none;
		}
	}
</style>

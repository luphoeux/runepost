---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { listQuests } from '../../utils/quests';
import { formatGold } from '../../utils/quest-types';
import type { Quest } from '../../utils/quest-types';

const quests = await listQuests();

// Agrupar misiones por cadena (Notion style)
const questsByChain = quests.reduce((acc: Record<string, any[]>, quest: any) => {
    const chain = quest.chain_name || 'Otras Misiones';
    if (!acc[chain]) acc[chain] = [];
    acc[chain].push(quest);
    return acc;
}, {});
const qualityColors: Record<string, string> = {
    Poor: '#9d9d9d',
    Common: '#ffffff',
    Uncommon: '#1eff00',
    Rare: '#0070dd',
    Epic: '#a335ee',
    Legendary: '#ff8000',
};

function qualityColor(q: string): string {
    return qualityColors[q] ?? '#fff';
}

const categoryIcons: Record<string, string> = {
    Principal: '!',
    Secundaria: '?',
    Clase: 'C',
    Diario: 'D',
};
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead
            title="Base de Datos de Misiones — WoW Forever"
            description="Consulta todas las misiones de WoW Forever: cadenas de quests, recompensas, NPCs y zonas."
        />
    </head>
    <body>
        <Header />

        <main>
            <div class="page-header">
                <div class="page-header-text">
                    <span class="badge badge-gold">WoW Forever</span>
                    <h1>Base de Datos de <span class="text-gradient">Misiones</span></h1>
                    <p class="subtitle">
                        {quests.length} {quests.length === 1 ? 'mision registrada' : 'misiones registradas'}.
                        Los datos se extraen directamente del juego.
                    </p>
                </div>
                <div class="stats-row">
                    <div class="stat-chip">
                        <span class="stat-value">{quests.length}</span>
                        <span class="stat-label">Misiones</span>
                    </div>
                    <div class="stat-chip">
                        <span class="stat-value">{new Set(quests.map(q => q.chain_name).filter(Boolean)).size}</span>
                        <span class="stat-label">Cadenas</span>
                    </div>
                    <div class="stat-chip">
                        <span class="stat-value">{new Set(quests.map(q => q.zone).filter(Boolean)).size}</span>
                        <span class="stat-label">Zonas</span>
                    </div>
                </div>
            </div>

            {quests.length === 0 ? (
                <div class="empty-state">
                    <div class="empty-icon">?</div>
                    <p>No hay misiones registradas aun.</p>
                </div>
            ) : (
                <div class="notion-tables">
                    {Object.entries(questsByChain).map(([chainName, chainQuests]) => (
                        <div class="chain-section">
                            <h2 class="chain-title">{chainName}</h2>
                            <div class="table-responsive">
                                <table class="notion-table">
                                    <thead>
                                        <tr>
                                            <th class="col-num"># Number</th>
                                            <th class="col-name">★ Mission Name</th>
                                            <th>📋 Objective</th>
                                            <th>📑 Category</th>
                                            <th>⏱ Time</th>
                                            <th class="col-desc">📝 Description</th>
                                            <th>👤 NPC Quest</th>
                                            <th class="text-right">+ XP Reward</th>
                                            <th class="text-right">💰 Gold Reward</th>
                                            <th class="text-center">📦 Item Reward</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {chainQuests.map((quest: Quest) => (
                                            <tr class="notion-row">
                                                <td class="col-num mono">{quest.id}</td>
                                                <td class="col-name fw-600">
                                                    <a href={`/quests/${quest.id}`}>{quest.title}</a>
                                                </td>
                                                <td class="truncate" title={quest.objectives?.[0]}>
                                                    {quest.objectives?.[0] || '-'}
                                                </td>
                                                <td>
                                                    <span class="n-badge n-badge-gray">
                                                        {quest.category || quest.quest_type || 'Story Quest'}
                                                    </span>
                                                </td>
                                                <td>
                                                    {quest.time_estimate ? (
                                                        <span class="n-badge n-badge-blue">{quest.time_estimate}</span>
                                                    ) : '-'}
                                                </td>
                                                <td class="truncate col-desc" title={quest.description?.replace(/<[^>]+>/g, '')}>
                                                    {quest.description ? quest.description.replace(/<[^>]+>/g, '').slice(0, 45) + '...' : '-'}
                                                </td>
                                                <td>
                                                    <span class="npc-badge">{quest.giver_npc || '-'}</span>
                                                </td>
                                                <td class="text-right mono">
                                                    {quest.reward_xp ? quest.reward_xp.toLocaleString() : '-'}
                                                </td>
                                                <td class="text-right mono">
                                                    {quest.reward_gold ? formatGold(quest.reward_gold) : '-'}
                                                </td>
                                                <td class="text-center">
                                                    {quest.reward_items && quest.reward_items.length > 0 ? (
                                                        <span class="n-badge n-badge-green n-badge-sm">Yes</span>
                                                    ) : (
                                                        <span class="n-badge n-badge-red n-badge-sm">No</span>
                                                    )}
                                                </td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </main>

        <Footer />
    </body>
</html>

<style>
    .page-header {
        margin-bottom: 3rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .page-header-text .badge {
        margin-bottom: 0.75rem;
    }

    .page-header-text h1 {
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: var(--color-text-muted);
        font-size: 1.05rem;
        margin: 0;
    }

    .stats-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .stat-chip {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 0.75rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 90px;
    }

    .stat-value {
        font-family: var(--font-heading);
        font-size: 1.75rem;
        font-weight: 900;
        color: var(--color-gold);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.25rem;
    }

    /* Notion-style Tables */
    .notion-tables {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .chain-title {
        font-size: 1.5rem;
        color: #f0e6c8;
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-bg-card);
    }

    .notion-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .notion-table th {
        text-align: left;
        padding: 0.75rem 1rem;
        color: var(--color-text-muted);
        font-weight: 500;
        border-bottom: 1px solid var(--color-border);
        background: rgba(0,0,0,0.2);
    }

    .notion-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        color: var(--color-text-main);
    }

    .notion-row:hover td {
        background: rgba(255,255,255,0.03);
    }

    .notion-row:last-child td {
        border-bottom: none;
    }

    /* Col específicas */
    .col-num { width: 60px; color: var(--color-text-muted); }
    .col-name { min-width: 220px; }
    .col-desc { max-width: 250px; }

    .notion-table a {
        color: #f0e6c8;
        text-decoration: none;
        transition: color 0.2s;
    }
    .notion-table a:hover {
        color: #c8a951;
    }

    .truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 200px;
    }

    .mono { font-family: monospace; font-size: 0.9rem; }
    .fw-600 { font-weight: 600; }
    .text-right { text-align: right !important; }
    .text-center { text-align: center !important; }

    /* Notion Badges */
    .n-badge {
        display: inline-block;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 500;
        line-height: 1.2;
    }

    .n-badge-sm {
        padding: 0.15rem 0.4rem;
        border-radius: 3px;
        font-weight: 600;
    }

    .n-badge-gray { background: rgba(155, 155, 155, 0.15); color: #c9c2b0; }
    .n-badge-blue { background: rgba(59, 130, 246, 0.15); color: #93c5fd; }
    .n-badge-green { background: rgba(34, 197, 94, 0.15); color: #86efac; }
    .n-badge-red { background: rgba(239, 68, 68, 0.15); color: #fca5a5; }

    .npc-badge {
        padding: 0.2rem 0.4rem;
        background: rgba(200, 169, 81, 0.1);
        border: 1px solid rgba(200, 169, 81, 0.2);
        border-radius: 4px;
        color: #c8a951;
        font-size: 0.75rem;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 6rem 2rem;
        color: var(--color-text-muted);
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #c8a951, #f0d060);
        color: #1a1208;
        font-size: 2.5rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-family: var(--font-heading);
        opacity: 0.4;
    }

    @media (max-width: 640px) {
        .quest-grid {
            grid-template-columns: 1fr;
        }
        .stats-row {
            justify-content: center;
        }
    }
</style>

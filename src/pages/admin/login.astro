---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSupabaseSSR } from '../../utils/supabaseServer.ts';

// Si ya hay sesión, mandarlo de una al panel
const supabase = getSupabaseSSR(Astro.cookies);
const { data: { session } } = await supabase.auth.getSession();
if (session) {
    return new Response(null, { status: 302, headers: { Location: '/admin/quests' } });
}

const error = Astro.url.searchParams.get('error');
---
<AdminLayout title="Iniciar Sesión">
    <div class="login-container">
        <div class="login-box">
            <div class="icon">🔒</div>
            <h2>Acceso Restringido</h2>
            <p>Solo el administrador puede entrar a esta zona para modificar la base de datos de misiones y objetos.</p>
            {error === 'oauth_failed' && (
                <div class="error-msg">
                    Error al iniciar sesión con Google. Comprueba la configuración en Supabase.
                </div>
            )}
            
            {error === 'unauthorized' && (
                <div class="error-msg">
                    Acceso denegado. Esta cuenta no tiene permisos de administrador.
                </div>
            )}

            {error === 'invalid_credentials' && (
                <div class="error-msg">
                    Correo o contraseña incorrectos. {Astro.url.searchParams.get('msg') && <br/> <small>Detalle: {Astro.url.searchParams.get('msg')}</small>}
                </div>
            )}

            <form action="/api/auth/signin-password" method="post" class="email-login-form" enctype="application/x-www-form-urlencoded">
                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email" required placeholder="admin@ejemplo.com" />
                </div>
                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••" />
                </div>
                <button type="submit" class="btn-primary login-btn">Iniciar Sesión</button>
            </form>

            <div class="divider">O continuar con</div>

            <form action="/api/auth/signin" method="post">
                <button type="submit" class="google-btn">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="G" class="g-icon" />
                    Ingresar con Google
                </button>
            </form>
        </div>
    </div>
</AdminLayout>

<style>
    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
    }
    .login-box {
        background: var(--admin-card);
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        padding: 3rem;
        max-width: 400px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }
    .icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
    .login-box h2 {
        margin: 0 0 1rem;
        color: white;
    }
    .login-box p {
        color: #8b949e;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 2rem;
    }
    .error-msg {
        background: rgba(248, 81, 73, 0.1);
        border: 1px solid rgba(248, 81, 73, 0.4);
        color: #ff7b72;
        padding: 0.75rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
    }
    .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        width: 100%;
        background: white;
        color: #333;
        border: none;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .google-btn:hover {
        background: #f1f1f1;
    }
    .g-icon {
        width: 18px;
        height: 18px;
    }

    /* Email Form Styles */
    .email-login-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: left;
    }
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .form-group label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #c9d1d9;
    }
    .form-group input {
        background: #0d1117;
        border: 1px solid var(--admin-border);
        color: #c9d1d9;
        padding: 0.75rem;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
    }
    .form-group input:focus {
        outline: none;
        border-color: var(--admin-accent);
        box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.3);
    }
    .login-btn {
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.75rem;
        background: #238636;
        color: white;
        border: 1px solid rgba(240, 246, 252, 0.1);
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .login-btn:hover {
        background: #2ea043;
    }
    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #8b949e;
        font-size: 0.85rem;
        margin: 1.5rem 0;
    }
    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid var(--admin-border);
    }
    .divider:not(:empty)::before {
        margin-right: .75em;
    }
    .divider:not(:empty)::after {
        margin-left: .75em;
    }
</style>

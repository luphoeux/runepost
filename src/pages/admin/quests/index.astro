---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listQuests } from '../../../utils/quests.ts';

import { getSupabaseSSR } from '../../../utils/supabaseServer.ts';

const supabase = getSupabaseSSR(Astro.cookies);
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
    return new Response(null, { status: 302, headers: { Location: '/admin/login' } });
}
const adminEmail = (import.meta as any).env?.ADMIN_EMAIL ?? process.env.ADMIN_EMAIL ?? '';
if (session.user?.email !== adminEmail) {
    return new Response(null, { status: 302, headers: { Location: '/admin/login?error=unauthorized' } });
}

const quests = await listQuests();
---
<AdminLayout title="Misiones">
    <div class="admin-header-row">
        <h2>Gestión de Misiones</h2>
        <span class="count-badge">{quests.length} misiones</span>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Tiempo Est.</th>
                    <th>Cadena</th>
                    <th>NPC</th>
                    <th class="text-right">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {quests.map(quest => (
                    <tr>
                        <td class="mono">{quest.id}</td>
                        <td class="fw-500">{quest.title}</td>
                        <td>{quest.category || quest.quest_type || '-'}</td>
                        <td>{quest.time_estimate || '-'}</td>
                        <td>{quest.chain_name || '-'}</td>
                        <td>{quest.giver_npc || '-'}</td>
                        <td class="text-right">
                            <a href={`/admin/quests/${quest.id}`} class="btn-edit">Editar</a>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</AdminLayout>

<style>
    .admin-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }
    .admin-header-row h2 {
        margin: 0;
        font-size: 1.5rem;
    }
    .count-badge {
        background: #21262d;
        border: 1px solid var(--admin-border);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
    }
    .admin-table-wrap {
        border: 1px solid var(--admin-border);
        border-radius: 6px;
        background: var(--admin-card);
        overflow-x: auto;
    }
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    .admin-table th {
        text-align: left;
        padding: 0.75rem 1rem;
        background: #1c2128;
        border-bottom: 1px solid var(--admin-border);
        color: #8b949e;
        font-weight: 600;
        white-space: nowrap;
    }
    .admin-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--admin-border);
    }
    .admin-table tr:last-child td {
        border-bottom: none;
    }
    .admin-table tr:hover td {
        background: rgba(255,255,255,0.02);
    }
    .mono { font-family: monospace; color: #8b949e; }
    .fw-500 { font-weight: 500; color: #c9d1d9; }
    .text-right { text-align: right; }
    
    .btn-edit {
        display: inline-block;
        background: #21262d;
        border: 1px solid var(--admin-border);
        color: var(--admin-accent);
        text-decoration: none;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.85rem;
        transition: all 0.2s;
    }
    .btn-edit:hover {
        background: #30363d;
        border-color: #8b949e;
    }
</style>

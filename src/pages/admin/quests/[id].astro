---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getQuestById, updateQuest } from '../../../utils/quests.ts';
import { getSupabaseSSR } from '../../../utils/supabaseServer.ts';

const supabase = getSupabaseSSR(Astro.cookies);
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
    return new Response(null, { status: 302, headers: { Location: '/admin/login' } });
}
const adminEmail = (import.meta as any).env?.ADMIN_EMAIL ?? process.env.ADMIN_EMAIL ?? '';
if (session.user?.email !== adminEmail) {
    return new Response(null, { status: 302, headers: { Location: '/admin/login?error=unauthorized' } });
}

const { id } = Astro.params;
const questId = Number(id);

let errorMsg = '';
let successMsg = '';

// Procesar formulario si es POST
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const updates = {
            title: formData.get('title') as string,
            chain_name: formData.get('chain_name') as string,
            time_estimate: formData.get('time_estimate') as string,
            category: formData.get('category') as string,
            giver_npc: formData.get('giver_npc') as string,
            description: formData.get('description') as string,
        };

        const { error } = await updateQuest(questId, updates);
        if (error) {
            errorMsg = error.message;
        } else {
            return Astro.redirect('/admin/quests');
        }
    } catch (e: any) {
        errorMsg = e.message;
    }
}

const quest = await getQuestById(questId);
if (!quest) {
    return Astro.redirect('/admin/quests');
}
---
<AdminLayout title={`Editar Misión #${quest.id}`}>
    <div class="admin-header-row">
        <h2>Editar Misión <span class="mono">#{quest.id}</span></h2>
        <a href="/admin/quests" class="btn-back">← Volver</a>
    </div>

    {errorMsg && <div class="alert alert-error">{errorMsg}</div>}
    
    <div class="admin-form-wrap">
        <form method="post" class="admin-form">
            <div class="form-grid">
                <div class="form-group">
                    <label>Título de la Misión</label>
                    <input type="text" name="title" value={quest.title} required />
                </div>
                
                <div class="form-group">
                    <label>Cadena (Chapter Name)</label>
                    <input type="text" name="chain_name" value={quest.chain_name || ''} placeholder="Ej: Chapter 1 - Call of the Light" />
                </div>

                <div class="form-group">
                    <label>Tiempo Estimado (Time)</label>
                    <input type="text" name="time_estimate" value={quest.time_estimate || ''} placeholder="Ej: <= 1 Minute" />
                </div>

                <div class="form-group">
                    <label>Categoría</label>
                    <input type="text" name="category" value={quest.category || quest.quest_type || ''} placeholder="Ej: Story Quest" />
                </div>

                <div class="form-group">
                    <label>NPC (Giver)</label>
                    <input type="text" name="giver_npc" value={quest.giver_npc || ''} />
                </div>
            </div>

            <div class="form-group full-width">
                <label>Descripción</label>
                <textarea name="description" rows="5">{quest.description}</textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</AdminLayout>

<style>
    .admin-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }
    .mono { color: #8b949e; font-family: monospace; }
    .btn-back {
        color: #8b949e;
        text-decoration: none;
        font-size: 0.9rem;
    }
    .btn-back:hover { color: white; text-decoration: underline; }

    .admin-form-wrap {
        background: var(--admin-card);
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        padding: 2rem;
    }

    .admin-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .form-group.full-width {
        grid-column: 1 / -1;
    }

    label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #c9d1d9;
    }

    input, textarea {
        background: #0d1117;
        border: 1px solid var(--admin-border);
        color: #c9d1d9;
        padding: 0.75rem;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
    }
    input:focus, textarea:focus {
        outline: none;
        border-color: var(--admin-accent);
        box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.3);
    }

    .form-actions {
        margin-top: 1rem;
        display: flex;
        justify-content: flex-end;
    }

    .btn-primary {
        background: #238636;
        color: white;
        border: 1px solid rgba(240, 246, 252, 0.1);
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-primary:hover {
        background: #2ea043;
    }

    .alert {
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }
    .alert-error {
        background: rgba(248, 81, 73, 0.1);
        border: 1px solid rgba(248, 81, 73, 0.4);
        color: #ff7b72;
    }
</style>

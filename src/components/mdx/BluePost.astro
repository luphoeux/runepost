---
interface Props {
    title?: string;
    date?: string;
}

const { title = 'Blizzard Entertainment', date } = Astro.props;
---

<div class="mdx-bluepost">
    <div class="bluepost-header">
        <div class="blizz-logo">B</div>
        <div class="header-text">
            <strong>{title}</strong>
            {date && <span class="date">{date}</span>}
        </div>
    </div>
    <div class="bluepost-body">
        <slot />
    </div>
</div>

<style>
    .mdx-bluepost {
        background-color: rgba(0, 116, 224, 0.05);
        border: 1px solid rgba(0, 116, 224, 0.2);
        border-radius: var(--radius-md);
        margin: 2.5rem 0;
        overflow: hidden;
    }
    .bluepost-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        background-color: rgba(0, 116, 224, 0.1);
        border-bottom: 1px solid rgba(0, 116, 224, 0.2);
    }
    .blizz-logo {
        width: 32px;
        height: 32px;
        background-color: #0074e0;
        color: white;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        font-family: var(--font-heading);
    }
    .header-text {
        display: flex;
        flex-direction: column;
    }
    .header-text strong {
        color: #66b3ff;
        font-size: 1.1rem;
    }
    .date {
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }
    .bluepost-body {
        padding: 1.5rem;
        color: #e2e8f0;
        font-size: 0.95rem;
    }
    .bluepost-body :global(p) {
        margin-bottom: 1rem;
    }
    .bluepost-body :global(p:last-child) {
        margin-bottom: 0;
    }
    .bluepost-body :global(a) {
        color: #66b3ff;
        text-decoration: underline;
    }
</style>
